package build

import mill._
import mill.api.JarManifest
import mill.define.ModuleRef
import mill.javalib._
import mill.util.Jvm
import os.Path

trait Defs {
  def version = "2.1"

  //toolchains
  def java8: ModuleRef[ZincWorkerModule] = ModuleRef(new ZincWorkerModule {
    override def jvmId = "temurin:8.0-442"
  })
  def currentJava: ModuleRef[ZincWorkerModule] = ModuleRef(ZincWorkerModule)

  //deps
  def jetbrainsAnnotations = ivy"org.jetbrains:annotations:26.1.0"
  def asm = ivy"org.ow2.asm:asm:9.10.1"
  def joptSimple = ivy"net.sf.jopt-simple:jopt-simple:6.0-alpha-3"

  def teavmCli = ivy"org.teavm:teavm-cli:0.14.1"
  def teavmJsoApis = ivy"org.teavm:teavm-jso-apis:0.14.1"
  def teavmJso = ivy"org.teavm:teavm-jso:0.14.1"
}

object Jargrep extends JavaModule with Defs {
  override def compileIvyDeps: T[Agg[Dep]] = Agg(jetbrainsAnnotations)
  override def ivyDeps: T[Agg[Dep]] = Agg(asm)
}

object JargrepCli extends JavaModule with Defs {
  //The CLI is compatible with Java 8.
  override def zincWorker: ModuleRef[ZincWorkerModule] = java8

  //Doing this 'multiloader-style' (not using a moduleDep) so that we
  //are free to compile the main module against Java 21.
  //override def moduleDeps: Seq[JavaModule] = Seq(Jargrep)
  override def sources: T[Seq[PathRef]] = super.sources() ++ Jargrep.sources()

  override def compileIvyDeps: T[Agg[Dep]] =
    Jargrep.compileIvyDeps() //multiloader style
  override def ivyDeps: T[Agg[Dep]] =
    Jargrep.ivyDeps() ++ //multiloader style
    Agg(joptSimple)

  override def manifest: T[JarManifest] = super.manifest().add(
    ("Implementation-Version", version),
    ("Main-Class", "agency.highlysuspect.jargrep.Cli")
  )

  override def assembly: T[PathRef] = Task {
    val renamed = Task.dest / s"jargrep-${version}-all.jar"
    os.move(super.assembly().path, renamed)
    PathRef(renamed)
  }

  object test extends JavaTests with TestModule.Junit5 {
    //pin the version
    override def bomIvyDeps: T[Agg[Dep]] = super.bomIvyDeps() ++ Agg(ivy"org.junit:junit-bom:5.14.4")
  }
}

object JargrepTea extends JavaModule with Defs {
  override def moduleDeps: Seq[JavaModule] = Seq(Jargrep)

  override def ivyDeps: T[Agg[Dep]] = super.ivyDeps() ++ Agg(teavmJsoApis, teavmJso)

  //just slap teavm-cli on the classpath with the assembly jar, it'll find it
  def teaClasspath: T[Agg[PathRef]] = Task {
    (defaultResolver().resolveDeps(Agg(teavmCli)) ++ Agg(assembly()))
  }

  def brewTea: T[PathRef] = Task {
    def dst = Task.dest / "jargrep.js"

    Jvm.callProcess(
      mainClass = "org.teavm.cli.TeaVMRunner",
      classPath = teaClasspath().map(_.path).toSeq,
      cwd = Task.dest,
      mainArgs = Seq(
        "-t", "javascript/js", "-f", "jargrep.js",
        "agency.highlysuspect.jargrep.TeaEntrypoint"
      )
    )

    println("tea is brewed! ", dst)
    PathRef(dst)
  }

  def packageTea: T[PathRef] = Task {
    def brewedTea = brewTea()
    def resourcesDirs = resources()

    for(rdir <- resourcesDirs) {
      os.copy(rdir.path, Task.dest, createFolders = true, mergeFolders = true)
    }
    os.copy.into(brewedTea.path, Task.dest)

    PathRef(Task.dest)
  }

  //i have the memory of a goldfish
  def teaUsage = Task {
    Jvm.callProcess(
      mainClass = "org.teavm.cli.TeaVMRunner",
      classPath = defaultResolver().resolveDeps(Agg(teavmCli)).map(_.path).toSeq,
    )
  }
}
